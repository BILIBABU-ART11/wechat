<view class="bind-page page">
  <view class="bind-head">
    <view class="bind-kicker">身份绑定</view>
    <view class="bind-title">绑定院院通用户 ID</view>
    <view class="bind-desc">当前微信尚未绑定内部身份。绑定后，仅会展示和提醒该用户 ID 下的待办。</view>
  </view>

  <view class="bind-card card">
    <view class="field-label">用户 ID 授权码</view>
    <input class="input" type="number" value="{{bindValue}}" placeholder="{{placeholder}}" bindinput="handleInput" />
    <button class="primary-button bind-button" loading="{{loading}}" bindtap="submitBind">确认绑定</button>
  </view>
</view>

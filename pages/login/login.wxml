<view class="login-page">
  <view class="login-hero">
    <view class="brand-kicker">待办提醒</view>
    <view class="brand-title">院院通</view>
    <view class="brand-desc">同步院院通待办统计，按绑定的用户 ID 接收个人提醒。</view>
  </view>

  <view class="login-panel">
    <view class="panel-title">微信登录</view>
    <view class="panel-desc">登录后系统会检查当前微信是否已绑定院院通用户 ID。未绑定用户需要先完成授权码绑定。</view>
    <button class="primary-button login-button" loading="{{loading}}" bindtap="handleLogin">微信一键登录</button>
    <view class="flow-list">
      <view class="flow-item"><text class="flow-index">1</text><text>微信授权登录</text></view>
      <view class="flow-item"><text class="flow-index">2</text><text>绑定院院通用户 ID</text></view>
      <view class="flow-item"><text class="flow-index">3</text><text>订阅并接收待办提醒</text></view>
    </view>
  </view>
</view>

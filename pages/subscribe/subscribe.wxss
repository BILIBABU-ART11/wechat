.subscribe-head {
  padding: 32rpx 4rpx 28rpx;
}

.subscribe-kicker {
  color: #126d8f;
  font-size: 24rpx;
  font-weight: 800;
}

.subscribe-title {
  margin-top: 12rpx;
  color: #172033;
  font-size: 44rpx;
  font-weight: 850;
}

.subscribe-desc {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 27rpx;
  line-height: 1.6;
}

.progress-card {
  padding: 34rpx 32rpx;
}

.progress-top {
  min-height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-label {
  color: #526275;
  font-size: 27rpx;
  font-weight: 700;
}

.progress-count {
  display: flex;
  align-items: baseline;
  color: #17324d;
}

.progress-current {
  font-size: 52rpx;
  font-weight: 850;
}

.progress-target {
  font-size: 26rpx;
  font-weight: 700;
}

.progress-track {
  width: 100%;
  height: 16rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e5ebf2;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: #16836a;
  transition: width 180ms ease;
}

.progress-status {
  margin-top: 20rpx;
  color: #64748b;
  font-size: 25rpx;
}

.action-button {
  margin-top: 24rpx;
}

.action-button[disabled] {
  background: #9aabba;
  color: #ffffff;
}

.skip-button {
  margin-top: 16rpx;
}

.privacy-note {
  padding: 26rpx 8rpx 0;
  color: #7a8797;
  font-size: 23rpx;
  line-height: 1.6;
}
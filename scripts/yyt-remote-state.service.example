[Unit]
Description=YYT Remote JSON State Service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/NeuroGaze_MiniProgram
Environment=NODE_ENV=production
Environment=REMOTE_STATE_HOST=127.0.0.1
Environment=REMOTE_STATE_PORT=3100
Environment=REMOTE_STATE_FILE=/opt/yyt-state/yyt-state.json
Environment=REMOTE_STATE_TOKEN=replace-with-strong-remote-state-token
ExecStart=/usr/bin/node scripts/remote-state-server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

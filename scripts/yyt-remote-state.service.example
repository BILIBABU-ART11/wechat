[Unit]
Description=YYT Remote JSON State Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yyt
Group=yyt
WorkingDirectory=/opt/NeuroGaze_MiniProgram
EnvironmentFile=/etc/yyt-remote-state.env
ExecStart=/usr/bin/node scripts/remote-state-server.js
Restart=always
RestartSec=5
UMask=0077
ReadWritePaths=/opt/yyt-state
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
